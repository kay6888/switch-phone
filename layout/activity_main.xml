<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1a1a1a">
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UNLIMITED SWITCH"
        android:textSize="24sp"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current Number"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>
    
    <TextView
        android:id="@+id/currentNumberText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No number assigned"
        android:textSize="20sp"
        android:textColor="#00ff88"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp"/>
    
    <Button
        android:id="@+id/switchNumberButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="GET NEW NUMBER →"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00ff88"
        android:textColor="#1a1a1a"
        android:layout_marginBottom="32dp"/>
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Number History"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>
    
    <TextView
        android:id="@+id/numberHistoryText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No history yet"
        android:textColor="#cccccc"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:background="#2a2a2a"
        android:padding="12dp"
        android:scrollbars="vertical"/>
</LinearLayout>
